<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.4.0 — "night ride" palette. One dark theme on purpose: the app is used at a bike, at
  night, through a helmet visor. Amber is the accent because it is what every motorcycle
  dashboard already uses for "look here".
-->
<resources>
    <!-- Surfaces (darkest → lightest) -->
    <color name="bg">#FF0B0F14</color>
    <color name="surface">#FF151B23</color>
    <color name="surface_2">#FF1C242E</color>
    <color name="outline">#FF2A3441</color>

    <!-- Accent -->
    <color name="accent">#FFFFB000</color>
    <color name="on_accent">#FF1A1200</color>
    <color name="accent_soft">#33FFB000</color>
    <color name="info">#FF4CC9F0</color>

    <!-- Text -->
    <color name="text_primary">#FFF2F5F8</color>
    <color name="text_secondary">#FF9AA7B4</color>
    <color name="text_tertiary">#FF6B7784</color>

    <!-- Status -->
    <color name="ok">#FF3DDC84</color>
    <color name="warn">#FFFFC857</color>
    <color name="bad">#FFFF5C5C</color>

    <!-- Legacy names still referenced by a few widgets -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
