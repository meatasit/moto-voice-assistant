<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.4.0 — home screen, product pass.

  Hero card answers "can I ride now?" in one glance: a coloured status dot + one line, then
  three chips for the things that actually vary day to day — which brain is answering
  (Cloud / Local), whether the helmet is connected, and whether we are online. Below it the
  v1.3.35 structure is unchanged: only problems that need a tap (hidden when healthy), two
  quick actions, then recent history inline.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moto Voice"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="จาวิส · ผู้ช่วยเสียงตอนขี่"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDebugLog"
                style="@style/Widget.Moto.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_receipt_long"
                android:contentDescription="@string/cd_debug_log" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Moto.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_settings"
                android:contentDescription="@string/cd_settings" />

        </LinearLayout>

        <!-- Hero: readiness at a glance. Tap → full system-status page. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            style="@style/Widget.Moto.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <!-- Coloured dot; MainActivity tints it ok / warn / bad. -->
                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_status_dot"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="กำลังตรวจสอบ..."
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipBrain"
                            style="@style/Widget.Moto.Chip"
                            android:text="☁️ Cloud AI" />

                        <TextView
                            android:id="@+id/chipHelmet"
                            style="@style/Widget.Moto.Chip"
                            android:text="🪖 หมวก" />

                        <TextView
                            android:id="@+id/chipNet"
                            style="@style/Widget.Moto.Chip"
                            android:layout_marginEnd="0dp"
                            android:text="📶 ออนไลน์" />

                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvHeroHint"
                    style="@style/Widget.Moto.RowSub"
                    android:layout_width="match_parent"
                    android:text="@string/hero_hint_helmet" />

                <!--
                  v1.4.9 — test from the phone while parked. Same front door as the helmet
                  button (VoiceAssistActivity → VoiceCommandService), so what the rider hears
                  here is exactly what the BVRA press will do. Hidden while the mic permission
                  is missing: a microphone foreground service cannot start without it.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTryNow"
                    style="@style/Widget.Moto.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    android:text="@string/home_try_now"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          v1.4.9 — "what can I say" card. A rider back after weeks away has only the hero
          hint ("speak after the beep") to go on; the command list lived in README. Kept
          short, collapsible, and the collapsed state is remembered.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCommands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Widget.Moto.Section"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/home_commands_title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleCommands"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/home_commands_hide" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCommands"
                    style="@style/Widget.Moto.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="4dp"
                    android:paddingEnd="8dp"
                    android:lineSpacingMultiplier="1.45"
                    android:text="@string/home_commands_body" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          Attention section — populated from HomeAlerts. `visibility=gone` is the
          resting state: a healthy install must not show an empty header.
        -->
        <LinearLayout
            android:id="@+id/alertsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvAlertsHeader"
                style="@style/Widget.Moto.Section"
                android:text="@string/home_alerts_title"
                android:textColor="@color/bad" />

            <LinearLayout
                android:id="@+id/alertsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Quick actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorites"
                style="@style/Widget.Moto.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:icon="@drawable/ic_star"
                android:text="รายการโปรด" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSystemStatus"
                style="@style/Widget.Moto.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:icon="@drawable/ic_monitor_heart"
                android:text="สถานะระบบ" />

        </LinearLayout>

        <!-- Recent history, inline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                style="@style/Widget.Moto.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="0dp"
                android:layout_marginTop="0dp"
                android:text="@string/home_recent_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistoryAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/home_see_all" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
