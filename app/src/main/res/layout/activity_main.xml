<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.3.35 — home screen rebuilt around "what does the rider need RIGHT NOW".

  Was: a static permission checklist (4 rows, always visible even when all granted),
  a Set-Default button, two nav buttons, and a how-to-use card. Everything above the
  fold was setup UI the solo rider had already finished months ago.

  Now: only problems that need a tap (hidden entirely when the install is healthy),
  then the recent history inline — the part that is actually worth opening the app for.
  The full status page and the full history list are still one tap away.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Moto Voice"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDebugLog"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📋"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:contentDescription="@string/cd_debug_log" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⚙️"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:contentDescription="@string/cd_settings" />

        </LinearLayout>

        <!-- Status banner — tap opens the full system-status page -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#1F1F1F"
            app:cardCornerRadius="12dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvStatusIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="24sp"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="กำลังตรวจสอบ..."
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          Attention section — populated from HomeAlerts. `visibility=gone` is the
          resting state: a healthy install must not show an empty header.
        -->
        <LinearLayout
            android:id="@+id/alertsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvAlertsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_alerts_title"
                android:textColor="#FFB4AB"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/alertsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Quick access -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorites"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="⭐ โปรด"
                android:textColor="@color/white"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSystemStatus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🩺 สถานะระบบ"
                android:textColor="@color/white"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Recent history, inline (was a button pre-v1.3.35) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recent_title"
                android:textColor="@color/purple_200"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <Button
                android:id="@+id/btnHistoryAll"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/home_see_all"
                android:textSize="13sp"
                android:textColor="@color/purple_200" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
