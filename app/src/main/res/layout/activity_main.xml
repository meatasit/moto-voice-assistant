<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.4.0 — home screen, product pass.

  Hero card answers "can I ride now?" in one glance: a coloured status dot + one line, then
  three chips for the things that actually vary day to day — which brain is answering
  (Cloud / Local), whether the helmet is connected, and whether we are online. Below it the
  v1.3.35 structure is unchanged: only problems that need a tap (hidden when healthy), two
  quick actions, then recent history inline.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moto Voice"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="จาวิส · ผู้ช่วยเสียงตอนขี่"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDebugLog"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:text="📋"
                android:textSize="18sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:contentDescription="@string/cd_debug_log" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:text="⚙️"
                android:textSize="18sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:contentDescription="@string/cd_settings" />

        </LinearLayout>

        <!-- Hero: readiness at a glance. Tap → full system-status page. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <!-- Coloured dot; MainActivity tints it ok / warn / bad. -->
                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_status_dot"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="กำลังตรวจสอบ..."
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/text_tertiary"
                        android:textSize="24sp" />

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipBrain"
                            style="@style/Widget.Moto.Chip"
                            android:text="☁️ Cloud AI" />

                        <TextView
                            android:id="@+id/chipHelmet"
                            style="@style/Widget.Moto.Chip"
                            android:text="🪖 หมวก" />

                        <TextView
                            android:id="@+id/chipNet"
                            style="@style/Widget.Moto.Chip"
                            android:layout_marginEnd="0dp"
                            android:text="📶 ออนไลน์" />

                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvHeroHint"
                    style="@style/Widget.Moto.RowSub"
                    android:layout_width="match_parent"
                    android:text="กดปุ่มบนหมวก แล้วพูดหลังเสียงบี๊บ" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          Attention section — populated from HomeAlerts. `visibility=gone` is the
          resting state: a healthy install must not show an empty header.
        -->
        <LinearLayout
            android:id="@+id/alertsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvAlertsHeader"
                style="@style/Widget.Moto.Section"
                android:text="@string/home_alerts_title"
                android:textColor="@color/bad" />

            <LinearLayout
                android:id="@+id/alertsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Quick actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorites"
                style="@style/Widget.Moto.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⭐  รายการโปรด" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSystemStatus"
                style="@style/Widget.Moto.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🩺  สถานะระบบ" />

        </LinearLayout>

        <!-- Recent history, inline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                style="@style/Widget.Moto.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="0dp"
                android:layout_marginTop="0dp"
                android:text="@string/home_recent_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistoryAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/home_see_all"
                android:textSize="13sp"
                android:textColor="@color/accent" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
