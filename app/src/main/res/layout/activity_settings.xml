<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.4.0 — settings, product pass. Five cards in the order the rider actually touches them:
  brain → connection → behaviour → voice → system. The Azure Neural TTS card is gone with
  the engine (see TtsRouter).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- ═══════════ 1. Brain ═══════════ -->
            <TextView style="@style/Widget.Moto.Section" android:text="สมอง AI" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">

                        <TextView style="@style/Widget.Moto.RowTitle" android:text="ใครเป็นคนคิด" android:textStyle="bold" />
                        <TextView style="@style/Widget.Moto.RowSub" android:layout_width="match_parent"
                            android:text="ทั้งสองแบบผ่าน n8n เหมือนกัน ต่างกันแค่ตัวที่แปลคำพูดเป็นคำสั่ง"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleLlmProvider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLlmApi"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="☁️  Cloud AI" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLlmLocal"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🖥️  Local LLM" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            android:id="@+id/tvLlmProviderHint"
                            style="@style/Widget.Moto.RowSub"
                            android:layout_width="match_parent"
                            android:layout_marginTop="10dp"
                            android:text="" />

                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="ใช้สมอง AI" />
                            <TextView style="@style/Widget.Moto.RowSub"
                                android:text="ปิด = เข้าใจเฉพาะคำสั่งตายตัวในเครื่อง ไม่ต่อเน็ต" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchLlm"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ 2. Connection ═══════════ -->
            <TextView style="@style/Widget.Moto.Section" android:text="การเชื่อมต่อ" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView style="@style/Widget.Moto.FieldLabel" android:text="Webhook URL (n8n)" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Moto.Input"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWebhookUrl"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:inputType="textUri"
                            android:hint="https://…/webhook/Javis" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Widget.Moto.FieldLabel" android:text="Auth Token" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Moto.Input"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etToken"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:inputType="textPassword"
                                android:hint="X-Auth-Token" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShowToken"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/token_show"
                            android:textColor="@color/accent"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <TextView style="@style/Widget.Moto.FieldLabel" android:text="รอคำตอบสูงสุด (วินาที) · 5–30" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Moto.Input"
                            android:layout_width="110dp" android:layout_height="wrap_content">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTimeout"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:inputType="number"
                                android:hint="15" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestConnection"
                            style="@style/Widget.Moto.Button.Tonal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="ทดสอบการเชื่อมต่อ" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTestResult"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="8dp"
                        android:text="" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ 3. Behaviour ═══════════ -->
            <TextView style="@style/Widget.Moto.Section" android:text="พฤติกรรม" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="ยืนยันก่อนโทรเสมอ" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="ถามซ้ำก่อนต่อสายทุกครั้ง" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchConfirmCall"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="ถามก่อนเปิด YouTube" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="เปิด = อ่าน 3 ตัวเลือกให้เลือก / ปิด = เปิดอันแรกทันที" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAskYoutube"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="ยืนยันเมื่อเริ่มเล่น" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="พูดสั้นๆ ว่า &quot;เล่นแล้วค่ะ&quot; เมื่อวิดีโอเริ่มจริง (ต้องให้สิทธิ์ควบคุมสื่อ)" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchConfirmMediaStart"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="เปิด YouTube ด้วยลิงก์เว็บ" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="ช่วยให้สลับคลิปตอนจอล็อคติดง่ายขึ้น — ปิดถ้าเปิดคลิปไม่ขึ้น" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchYoutubeWebLink"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="เปิดเพลงได้ตอนจอล็อค" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="สั่งเล่นตรงเข้า YouTube โดยไม่ต้องเปิดหน้าจอ — ปิดถ้าได้คลิปผิดตัว" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchYoutubeMediaBrowser"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="คุยต่อเนื่องหลังตอบ" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="เปิดฟังต่ออีก 4 วินาทีหลังจาวิสตอบ ไม่ต้องกดปุ่มอีก" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFollowup"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="เสียงทักเมื่อต่อหมวก" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="ทักตามช่วงเวลา แล้วอุ่นสมอง AI ให้พร้อมก่อนคำสั่งแรก" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchGreetOnConnect"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="เล่นวิทยุต่อหลังวางสาย" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="วิทยุ FM ที่ถูกสายเข้าตัด จะเล่นต่อเองเมื่อวางสาย" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchResumeAfterCall"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Widget.Moto.Divider" />

                    <LinearLayout style="@style/Widget.Moto.SwitchRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/Widget.Moto.RowTitle" android:text="ส่งเสียงสัญญาณเข้าหูฟัง" />
                            <TextView style="@style/Widget.Moto.RowSub" android:text="ทดลอง: ลองเปิดถ้าไม่ได้ยินเสียงบี๊บตอนกดปุ่ม — ทดสอบตอนจอดก่อน" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchEarconOnSco"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ 4. Voice ═══════════ -->
            <TextView style="@style/Widget.Moto.Section" android:text="เสียงของจาวิส" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <!-- Assistant volume 0.5 – 1.5 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView style="@style/Widget.Moto.RowTitle" android:layout_width="0dp"
                            android:layout_weight="1" android:text="ระดับเสียงผู้ช่วย" />
                        <TextView android:id="@+id/tvAssistantVolumeValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="1.0x" android:textColor="@color/accent"
                            android:textSize="14sp" android:fontFamily="monospace" />
                    </LinearLayout>
                    <TextView style="@style/Widget.Moto.RowSub" android:text="แยกจากเสียงเพลง — ใช้กับเสียงพูดของแอปเท่านั้น" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderAssistantVolume"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:stepSize="0.1" android:value="1.0" android:valueFrom="0.5" android:valueTo="1.5" />

                    <View style="@style/Widget.Moto.Divider" android:layout_marginStart="0dp" android:layout_marginEnd="0dp"
                        android:layout_marginTop="8dp" android:layout_marginBottom="16dp" />

                    <!-- TTS speech rate 0.8 – 1.5 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView style="@style/Widget.Moto.RowTitle" android:layout_width="0dp"
                            android:layout_weight="1" android:text="ความเร็วเสียงพูด" />
                        <TextView android:id="@+id/tvTtsRateValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="1.0x" android:textColor="@color/accent"
                            android:textSize="14sp" android:fontFamily="monospace" />
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderTtsRate"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:stepSize="0.1" android:value="1.0" android:valueFrom="0.8" android:valueTo="1.5" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreviewTts"
                        style="@style/Widget.Moto.Button.Outlined"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔊  ทดลองฟัง" />

                    <View style="@style/Widget.Moto.Divider" android:layout_marginStart="0dp" android:layout_marginEnd="0dp"
                        android:layout_marginTop="16dp" android:layout_marginBottom="16dp" />

                    <!-- v1.3.6 §1: จังหวะรอฟัง -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView style="@style/Widget.Moto.RowTitle" android:layout_width="0dp"
                            android:layout_weight="1" android:text="รอฟังก่อนตัดจบ" />
                        <TextView android:id="@+id/tvListenPaceValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="2.0s" android:textColor="@color/accent"
                            android:textSize="14sp" android:fontFamily="monospace" />
                    </LinearLayout>
                    <TextView style="@style/Widget.Moto.RowSub" android:text="ค่ามาก = พูดเว้นจังหวะได้นานขึ้น แต่ตอบช้าลง" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderListenPace"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:stepSize="0.1" android:value="2.0" android:valueFrom="1.0" android:valueTo="3.0" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════ 5. System ═══════════ -->
            <TextView style="@style/Widget.Moto.Section" android:text="ระบบ" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSystemStatus"
                        style="@style/Widget.Moto.LinkRow" android:text="🩺   สถานะระบบ" />
                    <View style="@style/Widget.Moto.Divider" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDefaultAssistant"
                        style="@style/Widget.Moto.LinkRow" android:text="🎙️   ตั้งเป็นผู้ช่วยหลัก (Digital Assistant)" />
                    <View style="@style/Widget.Moto.Divider" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBatteryOpt"
                        style="@style/Widget.Moto.LinkRow" android:text="🔋   ยกเว้นการประหยัดแบตเตอรี่" />
                    <View style="@style/Widget.Moto.Divider" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAppPermissions"
                        style="@style/Widget.Moto.LinkRow" android:text="🔐   สิทธิ์ของแอป" />
                    <View style="@style/Widget.Moto.Divider" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnReopenOnboarding"
                        style="@style/Widget.Moto.LinkRow" android:text="🧭   ตั้งค่าครั้งแรกอีกรอบ" />
                    <View style="@style/Widget.Moto.Divider" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnExportSettings"
                        style="@style/Widget.Moto.LinkRow" android:text="⬇   ส่งออกการตั้งค่า (JSON)" />
                    <View style="@style/Widget.Moto.Divider" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnImportSettings"
                        style="@style/Widget.Moto.LinkRow" android:text="⬆   นำเข้าการตั้งค่า (JSON)" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
